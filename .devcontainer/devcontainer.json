{
  "name": "Wealthfolio Tax Dev Environment",
  "image": "ivangabriele/tauri:debian-bookworm-22",

  "containerEnv": {
    "DISPLAY": ":99",
    "XVFB": "/usr/bin/Xvfb",
    "XVFBARGS": "-ac +extension RANDR",
    "X11VNC": "/usr/bin/x11vnc",
    "X11VNCARGS": "-forever -rfbport 5900",
    "LC_ALL": "en_US.UTF-8",
    "LANG": "en_US.UTF-8",
    "LANGUAGE": "en_US.UTF-8",
    "WEBKIT_DISABLE_DMABUF_RENDERER": "1"
  },

  "runArgs": [
    "--gpus=all",
    "--name=wealthfolio-tax-dev",
    "--hostname=wealthfolio-tax-dev",
    "--net=host"
  ],

  // Set the workspace to the standard GitHub Codespaces path
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  "mounts": [
    {
      "source": "devcontainer-cargo-cache-${devcontainerId}",
      "target": "/usr/local/cargo",
      "type": "volume"
    },
    {
      "source": "devcontainer-appdata-${devcontainerId}",
      "target": "/root/.local/share",
      "type": "volume"
    }
  ],

  "features": {
    "ghcr.io/stuartleeks/dev-container-features/shell-history:0": {},
    // ADDED: Official Node feature to ensure pnpm is globally available for Copilot
    "ghcr.io/devcontainers/features/node:1": {
      "version": "20",
      "pnpmVersion": "9.9.0"
    },
    "ghcr.io/rocker-org/devcontainer-features/apt-packages:1": {
      "packages": [
        "xvfb",
        "x11vnc",
        "net-tools",
        "locales",
        "locales-all"
      ]
    }
  },

  "overrideFeatureInstallOrder": [
    "ghcr.io/devcontainers/features/node",
    "ghcr.io/rocker-org/devcontainer-features/apt-packages"
  ],

  "forwardPorts": [1420, 1421, 5900],

  // UPDATED: Standard clean install command
  "postCreateCommand": "pnpm install",

  "postStartCommand": {
    "startXVFB": "/sbin/start-stop-daemon --start --quiet --background --exec $XVFB -- $DISPLAY $XVFBARGS",
    "startX11VNC": "/sbin/start-stop-daemon --start --quiet --background --exec ${X11VNC} -- -display ${DISPLAY} ${X11VNC_PASSWORD:+-passwd $X11VNC_PASSWORD} $X11VNCARGS -wait 10"
  },

  "customizations": {
    "settings": {
      "terminal.integrated.shell.linux": "/bin/bash",
      // ADDED: Tell TypeScript where to look for modules in a monorepo
      "typescript.tsdk": "node_modules/typescript/lib"
    },
    "vscode": {
      "extensions": [
        "github.copilot",
        "github.copilot-chat",
        "rust-lang.rust-analyzer",
        "tauri-apps.tauri-vscode",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "dbaeumer.vscode-eslint",
        "tamasfe.even-better-toml",
        "mhutchie.git-graph"
      ]
    }
  },

  "remoteUser": "root"
}
