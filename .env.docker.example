# Wealthfolio Docker Deployment Configuration
# Copy this file to .env.docker and update with your values
# Usage: docker compose -f compose.yml -f compose.dev.yml --env-file .env.docker up

# Server Port (default: 8088)
WF_PORT=8088

# Secret key for session encryption (generate with: openssl rand -base64 32)
# REQUIRED - set a strong random key
WF_SECRET_KEY=your-secret-key-here-replace-with-openssl-rand-base64-32

# Optional: Password hash for authentication (Argon2id format)
# If not set, no password authentication is required
# Generate with: htpasswd -B -C 10 -nb admin <password> | cut -d: -f2
WF_AUTH_PASSWORD_HASH=

# Optional: Authentication token TTL in minutes (default: 60)
WF_AUTH_TOKEN_TTL_MINUTES=60

# Optional: CORS allowed origins (comma-separated, default: *)
# For production, restrict to your domain
WF_CORS_ALLOW_ORIGINS=*

# Optional: Request timeout in milliseconds (default: 30000)
WF_REQUEST_TIMEOUT_MS=30000

# Wealthfolio Connect integration (optional)
# Leave empty to disable
CONNECT_AUTH_URL=
CONNECT_AUTH_PUBLISHABLE_KEY=

# Database path (inside container)
# Usually no need to change this
# WF_DB_PATH=/data/wealthfolio.db
